# ==============================================================================
# NGHEAN.TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường của bạn.
# ==============================================================================

# Cấu hình Server
PORT=5000
NODE_ENV=production
SITE_URL=https://nghean.today
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_2026

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=Nghean.today Platform
BRAND_NAME=Nghean.today
BRAND_SHORT_NAME=Nghệ An
AI_AGENT_NAME=AI NgheAn Assistant
SUPPORT_EMAIL=support@nghean.today

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nghean_today_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Quên mật khẩu, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Quản Trị Nghean.today
SMTP_FROM="Nghean.today" <your_email@gmail.com>
