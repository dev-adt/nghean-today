# ==============================================================================
# CODEBASE TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường của bạn.
# ==============================================================================

# Cấu hình Server
PORT=5000
NODE_ENV=production
SITE_URL=https://vtv8.vn
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_2026

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=VTV8.today Platform
BRAND_NAME=VTV8.today
BRAND_SHORT_NAME=VTV8
AI_AGENT_NAME=AI VTV8 Assistant
SUPPORT_EMAIL=support@vtv8.vn

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vtv8_today_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Quên mật khẩu, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Quản Trị VTV8.today
SMTP_FROM="VTV8.today" <your_email@gmail.com>
