# ─────────────────────────────────────────────
# VTV8.today — Environment Variables (MySQL version)
# Copy file này thành .env trên VPS rồi điền thông tin vào
# KHÔNG commit file .env lên git!
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=3023
SITE_URL=https://dev.vtv8.today
ALLOWED_ORIGIN=https://dev.vtv8.today

# ── MySQL Database ─────────────────────────────
# Thông tin cấu hình trong aaPanel > Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vtv8
DB_USER=vtv8
DB_PASSWORD=DIEN_MAT_KHAU_DATABASE_CUA_BAN_VAO_DAY

# ── AI Providers ──────────────────────────────
# Điền API key dịch vụ AI bạn muốn dùng
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
